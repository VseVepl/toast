{
    "name": "vsent/laravel-livewire-toasts",
    "description": "A Laravel package for displaying Livewire toasts.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "VSENT",
            "email": "contact@vsent.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Vsent\\LaravelLivewireToasts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vsent\\LaravelLivewireToasts\\Providers\\ToastServiceProvider"
            ],
            "aliases": {
                "Toast": "Vsent\\LaravelLivewireToasts\\Facades\\Toast"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
